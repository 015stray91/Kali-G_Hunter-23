#!/bin/bash

############################################################################################
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Kernel Source:
# git clone --depth 1 --branch MMI-T1TGNS33.60-41-2-7 https://github.com/MotorolaMobilityLLC/kernel-msm.git kernel
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
############################################################################################

##############################################
# Device Configuration
##############################################

# Device info
export DEVICE_NAME="genevn"
export DEVICE_CODENAME="G_Hunter"
export DEVICE_FULL_NAME="Motorola G Stylus 5G (2023)"
export DEVICE_MODEL="XT-2315"

# Architecture (64-bit)
export ARCH=arm64
export SUBARCH=arm64

# Defconfig
export DEFCONFIG=genevn_defconfig

# Compiler/Toolchain
export CROSS_COMPILE=aarch64-linux-android-
export CROSS_COMPILE_ARM32=arm-linux-androideabi-

# Kernel build configuration
export KERNEL_DIR="$PWD/kernel"
export OUT_DIR="$PWD/out"

# NetHunter specific
export ENABLE_NETHUNTER=1
